    "axes[1].barh([asset_names[i] for i in top], mean_w[top], color=SERIES[0], height=0.62)\n",
    "axes[1].axvline(1 / len(asset_names), color=SERIES[1], ls=\"--\", lw=1.4)\n",
    "axes[1].annotate(f\"equal weight = {1/len(asset_names):.3f}\",\n",
    "                 xy=(1 / len(asset_names), len(top) - 0.5), xytext=(4, 0),\n",
    "                 textcoords=\"offset points\", color=SERIES[1], fontsize=9)\n",
    "axes[1].set_xlabel(\"Mean weight\")\n",
    "axes[1].set_title(\"Top holdings by mean weight\", fontweight=\"bold\")\n",
    "axes[1].grid(axis=\"y\", visible=False)\n",
    "\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "hhi = (W_hist[1:] ** 2).sum(axis=1)\n",
    "print(f\"Mean turnover / day  : {res['turnover'].mean():.4f}  \"\n",
    "      f\"(1.0 = the whole book traded once)\")\n",
    "print(f\"Mean HHI             : {hhi.mean():.4f}   \"\n",
    "      f\"(equal weight = {1/len(asset_names):.4f}, single asset = 1.0)\")\n",
    "print(f\"Effective # assets   : {1/hhi.mean():.1f} of {len(asset_names)}\")\n",
    "print(f\"Total costs paid     : LKR {res['costs'].sum():,.0f} \"\n",
    "      f\"({res['costs'].sum()/init_val:.2%} of initial capital)\")"
   ],
   "execution_count": null,
